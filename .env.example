# Copy to .env (git-ignored) for local development, or set these in Vercel →
# Project → Settings → Environment Variables. Never commit a real key.

# Google Gemini API key from https://aistudio.google.com/apikey
# Leave empty to run in the clearly labelled reduced (no-AI) mode.
GEMINI_API_KEY=

# Optional settings (defaults shown)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models tried when the primary returns 503 (overloaded), e.g. gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=
AI_TIMEOUT_SECONDS=25
SOURCE_TIMEOUT_SECONDS=20
MAX_ARTICLE_CHARS=6000
MAX_CANDIDATES=40
RATE_LIMIT_PER_MINUTE=10
# Contact e-mail added to the User-Agent sent to Quranpedia, as their policy requests
QURANPEDIA_CONTACT=
# QURAN_CACHE_DIR=/tmp/quran-auditor-cache
