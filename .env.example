# Copy to .env (git-ignored) for local development, or set these in the host's dashboard
# (Render: service → Environment; see docs/RENDER_DEPLOY.md). Never commit a real key.

# --- AI candidate extraction (optional; the app works without it in reduced mode) ---
# auto (default): Groq if GROQ_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else no AI.
# groq | gemini: use only that provider. none: never call AI.
# Exactly one provider is called per audit; on failure the audit falls back to
# deterministic extraction, never to another model.
AI_PROVIDER=auto

# Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# Structured-output model (strict json_schema). Groq lists qwen/qwen3.8-27b as a preview model.
GROQ_MODEL=qwen/qwen3.8-27b
# Extraction prompt version (app/extraction/prompts.py); v2 chosen 30 Sep 2026, see docs/EVALUATION.md
EXTRACTION_PROMPT=v2
# Empty = send reasoning_effort "none" for qwen/ models only; "omit" = never send it.
GROQ_REASONING_EFFORT=
# Output tokens reserved per Groq request (default 4096). If your Groq account limits the model to 1,000 output tokens/minute
# (our free tier did: HTTP 429 «Request too large … OTPM»), set 800. See README "Environment variables" and docs/TEST_LOG.md.
# GROQ_MAX_COMPLETION_TOKENS=800

# Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated Gemini models tried when the primary returns 503. Leave empty to save quota.
GEMINI_FALLBACK_MODELS=

# Total AI time per audit, the cap per Gemini attempt, and how long to skip AI after a failure
AI_TIMEOUT_SECONDS=12
AI_ATTEMPT_TIMEOUT_SECONDS=8
AI_COOLDOWN_SECONDS=60

SOURCE_TIMEOUT_SECONDS=20
MAX_ARTICLE_CHARS=6000
MAX_CANDIDATES=40
RATE_LIMIT_PER_MINUTE=10
# Contact e-mail added to the User-Agent sent to Quranpedia, as their policy requests
QURANPEDIA_CONTACT=
# QURAN_CACHE_DIR=/tmp/quran-auditor-cache
